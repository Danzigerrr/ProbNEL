 for label in words[1::2]:\n","                entity_types.add(label)\n","    return sorted(list(entity_types))\n","\n","def tokenize_and_format_data(data, tokenizer, entity_types):\n","    tokenized_data = []\n","    for text in data:\n","        if not text.strip():\n","            continue\n","        text_lines = text.strip().split('\\n')\n","        words = []\n","        labels = []\n","        for line in text_lines:\n","            line_words = line.strip().split()\n","            if len(line_words) > 1:\n","                words.extend(line_words[::2])\n","                labels.extend(line_words[1::2])\n","\n","        encoded = tokenizer(words, is_split_into_words=True, padding='max_length', truncation=True)\n","        input_ids = encoded['input_ids']\n","        word_ids = encoded.word_ids()\n","\n","        label_ids = []\n","        previous_word_idx = None\n","        for word_idx in word_ids:\n","            if word_idx is None:\n","                label_ids.append(-100)\n","            elif word_idx != previous_word_idx:\n","                if word_idx is not None and word_idx < len(labels): #check if word_idx is in range\n","                    label_ids.append(entity_types.index(labels[word_idx]))\n","                else:\n","                    label_ids.append(-100) #add padding if the index is out of range\n","            else:\n","                if word_idx is not None and word_idx < len(labels): #check if word_idx is in range\n","                    label_ids.append(entity_types.index(labels[word_idx]) if labels[word_idx] != 'O' else entity_types.index('O'))\n","                else:\n","                    label_ids.append(-100) #add padding if the index is out of range\n","            previous_word_idx = word_idx\n","\n","        tokenized_data.append({'input_ids': input_ids, 'labels': label_ids})\n","\n","    return TensorDataset(\n","        torch.tensor([item['input_ids'] for item in tokenized_data]),\n","        torch.tensor([item['labels'] for item in tokenized_data])\n","    )\n","\n","def train_model(model, train_data, learning_rate, epochs):\n","    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","    model.to(device)\n","    optimizer = AdamW(model.parameters(), lr=learning_rate)\n","    train_dataloader = DataLoader(train_data, batch_size=32, shuffle=True)\n","\n","    model.train()\n","    for epoch in range(epochs):\n","        print(f\"Epoch {epoch+1}/{epochs}\")\n","        for batch in tqdm(train_dataloader, desc=\"Training\"):\n","            inputs = batch[0].to(device)\n","            labels = batch[1].to(device)\n","            outputs = model(inputs, labels=labels)\n","            loss = outputs.loss\n","            loss.backward()\n","            optimizer.step()\n","            optimizer.zero_grad()\n","    print(\"Training complete!\")"],"metadata":{"id":"KWeEfC7bm4EJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["file_path = \"/content/drive/MyDrive/Praca magisterska/Google colab - notebooks/FEWNERD-supervised/train.txt\"\n","with open(file_path, 'r', encoding='utf-8') as file:\n","  data = file.read().split('\\n\\n')\n","\n","entity_types = create_entity_types(file_path)\n","num_labels = len(entity_types)\n","print(\"Entity types:\", entity_types)\n","print(\"Number of labels:\", num_labels)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8w5H_Rm2fBLX","executionInfo":{"status":"ok","timestamp":1735311270381,"user_tz":-60,"elapsed":7012,"user":{"displayName":"Krzysiek Nazar","userId":"17643356553890215733"}},"outputId":"467dc3d8-e8c4-4483-cfb4-63bb5de9dd9a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Entity types: ['O', 'art-broadcastprogram', 'art-film', 'art-music', 'art-other', 'art-painting', 'art-writtenart', 'building-airport', 'building-hospital', 'building-hotel', 'building-library', 'building-other', 'building-restaurant', 'building-sportsfacility', 'bu