\n","ner_probabilities = np.array([0.7, 0.2, 0.1])  # Example softmax output\n","\n","# 3. Simulate Candidate KG Types\n","kg_types = [\"Person\", \"Athlete\", \"BasketballPlayer\", \"Agent\"]\n"],"metadata":{"id":"dblXc4sOH3FJ","executionInfo":{"status":"ok","timestamp":1742200341024,"user_tz":-60,"elapsed":8,"user":{"displayName":"Krzysztof Nazar","userId":"17643356553890215733"}}},"execution_count":51,"outputs":[]},{"cell_type":"code","source":["# 4. Generate Embeddings for NER Classes\n","def get_embedding(word):\n","    \"\"\"Generate word embedding using Flair.\"\"\"\n","    sentence = Sentence(word)\n","    stacked_embeddings.embed(sentence)\n","    return sentence[0].embedding.cpu().detach().numpy()\n","\n","ner_embeddings = {cls: get_embedding(cls) for cls in ner_classes}\n","kg_embeddings = {kg_type: get_embedding(kg_type) for kg_type in kg_types}\n"],"metadata":{"id":"V8gAvm7gDnp7","executionInfo":{"status":"ok","timestamp":1742200341053,"user_tz":-60,"elapsed":25,"user":{"displayName":"Krzysztof Nazar","userId":"17643356553890215733"}}},"execution_count":52,"outputs":[]},{"cell_type":"code","source":["# 5. Compute Cosine Similarity\n","similarity_matrix = np.zeros((len(ner_classes), len(kg_types)))\n","\n","for i, ner_cls in enumerate(ner_classes):\n","    for j, kg_type in enumerate(kg_types):\n","        similarity_matrix[i, j] = 1 - cosine(ner_embeddings[ner_cls], kg_embeddings[kg_type])  # Cosine similarity\n","\n","# 6. Compute Final Scores Using Correct max() Application\n","final_scores = {}\n","\n","for j, kg_type in enumerate(kg_types):\n","    # Find max similarity *per class* for this KG type\n","    max_similarities = np.max(similarity_matrix[:, j])  # Find best matching NER class\n","    weighted_score = sum(ner_probabilities[i] * similarity_matrix[i, j] for i in range(len(ner_classes)))  # Corrected formula\n","\n","    final_scores[kg_type] = weighted_score\n","\n","# 7. Print Results\n","print(\"\\nCosine Similarity Matrix (NER Classes vs. KG Types):\")\n","print(similarity_matrix)\n","\n","print(\"\\nFinal Weighted Scores:\")\n","for kg_type, score in sorted(final_scores.items(), key=lambda x: x[1], reverse=True):\n","    print(f\"{kg_type}: {score:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"B8wNhErSFFUG","executionInfo":{"status":"ok","timestamp":1742200341070,"user_tz":-60,"elapsed":11,"user":{"displayName":"Krzysztof Nazar","userId":"17643356553890215733"}},"outputId":"05e88337-9032-4069-a83d-a432af3e19e3"},"execution_count":53,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Cosine Similarity Matrix (NER Classes vs. KG Types):\n","[[0.72861152 0.43972672 0.27817479 0.38881934]\n"," [0.19112516 0.1947176  0.319115   0.19195346]\n"," [0.39082377 0.43731621 0.25747063 0.27378657]]\n","\n","Final Weighted Scores:\n","Person: 0.5873\n","Athlete: 0.3905\n","Agent: 0.3379\n","BasketballPlayer: 0.2843\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"AsBvQhM-LPxV","executionInfo":{"status":"ok","timestamp":1742200341074,"user_tz":-60,"elapsed":2,"user":{"displayName":"Krzysztof Nazar","userId":"17643356553890215733"}}},"execution_count":53,"outputs":[]}]}