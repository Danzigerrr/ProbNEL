entity_mentions})\"  # Preview the text\n","\n","    def print_entity_details(self):\n","        print(f\"Text: {self.text[:100]}...\")  # Show a preview of the text\n","        print(\"=\" * 40)\n","        for entity in self.entity_mentions:\n","            entity.print_entity_details()\n","\n","    def to_dict(self):\n","        # Convert Text object to a dictionary\n","        return {\n","            'text': self.text,\n","            'entity_mentions': [entity.to_dict() for entity in self.entity_mentions]\n","        }\n"],"metadata":{"id":"dw6hf60CMFQy","executionInfo":{"status":"ok","timestamp":1741949936754,"user_tz":-60,"elapsed":7,"user":{"displayName":"Krzysztof Nazar","userId":"17643356553890215733"}}},"execution_count":93,"outputs":[]},{"cell_type":"code","source":["def convert_data(data: str) -> List[Text]:\n","    parsed_data = json.loads(data)\n","\n","    texts = []\n","    for item in parsed_data:\n","        text = item['text']\n","        entity_mentions = []\n","\n","        for entity in item['entity_mentions']:\n","            surface_form = entity['surface_form']\n","            position = Position(*entity['position']['py/tuple'])\n","            target_uri = entity['target_uri']\n","\n","            entity_obj = Entity(surface_form, position, target_uri)\n","            entity_mentions.append(entity_obj)\n","\n","        text_obj = Text(text, entity_mentions)\n","        texts.append(text_obj)\n","\n","    return texts\n",""],"metadata":{"id":"llo9k7qy2Tm4","executionInfo":{"status":"ok","timestamp":1741949936767,"user_tz":-60,"elapsed":5,"user":{"displayName":"Krzysztof Nazar","userId":"17643356553890215733"}}},"execution_count":94,"outputs":[]},{"cell_type":"code","source":["# Convert data into structured information\n","structured_data = convert_data(raw_data)\n","\n","# Print entity details in a structured way\n","for text in structured_data[:1]:\n","    text.print_entity_details()"],"metadata":{"colab":{"base_uri":"https://localhost:80