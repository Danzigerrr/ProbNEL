rget_uri\": \"http://dbpedia.org/resource/Munich\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Germany\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [41, 48]}, \"target_uri\": \"http://dbpedia.org/resource/Germany\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Munich Re\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [254, 263]}, \"target_uri\": \"http://dbpedia.org/resource/Munich_Re\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Munich Re\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [480, 489]}, \"target_uri\": \"http://dbpedia.org/resource/Munich_Re\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Munich Re\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [595, 604]}, \"target_uri\": \"http://dbpedia.org/resource/Munich_Re\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"DAX\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [650, 653]}, \"target_uri\": \"http://dbpedia.org/resource/DAX\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"EU experts postpone talks on rice area aid . BRUSSELS 1996-12-06 European Union rice experts on Thursday postponed discussion on area aid payments to rice producers because the documents were not available in all the EU languages , an EU offcial said on Friday . \\\" The discussion in the experts group had to be postponed because the documents needed to be translated into the official languages and the item will be on next week 's agenda , \\\" the offcial said . European rice producers are due to get compensatory area aid payments similar to those paid to cereal producers because of cuts in intervention prices . -- Brussels Newsroom 32 2 287 6800\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"BRUSSELS\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [45, 53]}, \"target_uri\": \"http://dbpedia.org/resource/Brussels\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"European Union\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [65, 79]}, \"target_uri\": \"http://dbpedia.org/resource/European_Union\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"European\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [462, 470]}, \"target_uri\": \"http://dbpedia.org/resource/European_Union\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Frankfurt dollar fix 1.5338 marks . FRANKFURT 1996-12-06 The dollar was fixed at 1.5338 marks in Frankfurt on Friday , after 1.5607 marks on Thursday . There was no Bundesbank intervention .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Frankfurt\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 9]}, \"target_uri\": \"http://dbpedia.org/resource/Frankfurt_Stock_Exchange\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"FRANKFURT\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [36, 45]}, \"target_uri\": \"http://dbpedia.org/resource/Frankfurt\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Frankfurt\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [97, 106]}, \"target_uri\": \"http://dbpedia.org/resource/Frankfurt_Stock_Exchange\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Bundesbank\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [165, 175]}, \"target_uri\": \"http://dbpedia.org/resource/Deutsche_Bundesbank\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"John Lewis UK store sales up 4.5 % in week . LONDON 1996-12-06 The John Lewis Partnership said its UK department store sales rose 4.5 percent in the week to November 30 compared with the same week a year earlier . In the 18 weeks to November 30 , sales were up 13.6 percent year-on-year . Total sales , including the Waitrose supermarket chain , rose 5.8 percent in the week and were up 11.4 percent in the 18-week period . -- Rosemary Bennett , London Newsroom 44 171 542 2774\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"LONDON\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [45, 51]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"John Lewis\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [67, 77]}, \"target_uri\": \"http://dbpedia.org/resource/John_Lewis_Partnership\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Timah at 15.625 in London at 0931 GMT . LONDON 1996-12-06 PT Tambang Timah was traded at $ 15.625 per GDR in London on Friday at around 0931 GMT . It recorded a low of $ 15.625 and a high of $ 15.725 . Its previous close on Thursday was $ 15.80 . One Global Depository Receipt represents 10 common shares . -- Jakarta newsroom +6221 384-6364\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"London\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [19, 25]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"GMT\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [34, 37]}, \"target_uri\": \"http://dbpedia.org/resource/Greenwich_Mean_Time\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"LONDON\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [40, 46]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"London\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [109, 115]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"GMT\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [141, 144]}, \"target_uri\": \"http://dbpedia.org/resource/Greenwich_Mean_Time\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Jakarta\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [310, 317]}, \"target_uri\": \"http://dbpedia.org/resource/Jakarta\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"British \\\" Euro-sceptic \\\" says Clarke should resign . LONDON 1996-12-06 A \\\" Euro-sceptic \\\" member of the ruling Conservative party said on Thursday British finance minister Kenneth Clarke had to resign to prevent the party disintegrating over the issue of a single European currency . Member of Parliament Tony Marlow said the resignation of the chancellor of the exchequer was the only way to make the Conservatives electable in a general election which must take place by May next year . \\\" We have a divided and split Cabinet . This cannot endure , \\\" Marlow told BBC television 's Newsnight programme on Thursday . \\\" It is not sustainable . Kenneth Clarke has to go . If he does n't resign , the prime minister has got to fire him . \\\" Marlow 's comment come on the heels of speculation that Clarke had threatened to resign if the government changed its \\\" wait and see \\\" policy on a single currency and declared it would not sign up for the currency in the next Parliament . Clarke denied on Thursday he had threatened to resign and said his position on the single currency was in tune with that of Prime Minister John Major . Major told parliament on Thursday he would keep his options open on single-currency membership . His statement was interpreted as a significant victory for Clarke and fellow pro-European Michael Heseltine , deputy prime minister . Pro-European Conservative MP Edwina Currie told the BBC that if Clarke resigned , other ministers would go with him .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"British\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 7]}, \"target_uri\": \"http://dbpedia.org/resource/United_Kingdom\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Euro-sceptic\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [10, 22]}, \"target_uri\": \"http://dbpedi