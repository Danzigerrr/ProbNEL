ilers . -- Brussels Newsroom +32 2 287 6810 , Fax +32 2 230 7710\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"LUXEMBOURG\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 10]}, \"target_uri\": \"http://dbpedia.org/resource/Luxembourg\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"BRUSSELS\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [53, 61]}, \"target_uri\": \"http://dbpedia.org/resource/Brussels\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Luxembourg\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [73, 83]}, \"target_uri\": \"http://dbpedia.org/resource/Luxembourg\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"London coal / ore fixtures . LONDON 1996-12-06 COAL - Lantau Peak - 120,000 tones coal Hay Point or Newcastle / Kaohsiung 20-30/1 $ 5.25 and $ 5.85 fio respectively 40,000-35,000 / 28,000 shinc China Steel . Royal Clipper - 77,000 tonnes coal Maracaibo / Fos 19/12-2/1 $ 9.90 fio 20,000 shinc / 25,000 shinc Coe and Clerici . ORE - IMC TBN - 70,000 tonnes Dampier / Kaohsiung 20-30/12 $ 5.25 fio 35,000 shinc / 30,000 shinc China Steel .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"London\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 6]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"LONDON\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [29, 35]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Lantau Peak\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [54, 65]}, \"target_uri\": \"http://dbpedia.org/resource/Lantau_Peak\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Hay Point\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [87, 96]}, \"target_uri\": \"http://dbpedia.org/resource/Hay_Point,_Queensland\"}, {\"p