"target_uri\": \"http://dbpedia.org/resource/United_Nations_High_Commissioner_for_Refugees\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Bangui\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [352, 358]}, \"target_uri\": \"http://dbpedia.org/resource/Bangui\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Abidjan\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [379, 386]}, \"target_uri\": \"http://dbpedia.org/resource/Abidjan\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Senegal proposes foreign minister for U.N. post . DAKAR 1996-12-06 Senegal 's President Abdou Diouf said on Friday he was proposing his foreign minister Moustapha Niasse for the post of United Nations secretary-general . Diouf announced his intention to reporters when he returned from the Franco-African summit in Burkina Faso where an African successor to Secretary-General Boutros Boutros-Ghali was discussed . The United States has vetoed a second term for the Egyptian but left the door open for another African candidate . \\\" If Africa does not wish to lose its turn we have to act fast , \\\" Diouf said . \\\" Some of my brother heads of state asked me if I would n't nominate Moustapha Niasse . I see in him the profile of a secretray-general of the United Nations and I have given my endorsement . \\\"\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Senegal\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 7]}, \"target_uri\": \"http://dbpedia.org/resource/Senegal\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"U.N.\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [38, 42]}, \"target_uri\": \"http://dbpedia.org/resource/United_Nations\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"DAKAR\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [50, 55]}, \"target_uri\": \"http://dbpedia.org/resource/Dakar\"}, {\"py/object\": \"data.entity.TestEntity\