ject\": \"data.entity.TestEntity\", \"surface_form\": \"American\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2408, 2416]}, \"target_uri\": \"http://dbpedia.org/resource/United_States\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Office of Fair Trading\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2597, 2619]}, \"target_uri\": \"http://dbpedia.org/resource/Office_of_Fair_Trading\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Med oil products mostly lower as Elf strike ends . LONDON 1996-12-06 Mediterranean oil products were steady to mostly lower on Friday after Elf refinery workers voted to end their nine-day strike . Gas oil erased Thursday 's gains , plunging $ 5.50 a tonne in line with the screen . Volume was very thin and market remained long , with premiums down $ 1 at about high cif quotes +$0.50 basis Genoa . \\\" The sharp moves on the screen make everyone nervous , \\\" a trader said . Trades were discussed in 0.2 , 0.5 and one percent heating oil into Syria and Lebanon and there were fresh inquiries from France and Spain for low sulphur diesel . Interest remains focussed on a tender by India for a second purchase of high speed diesel for January delivery . Fuel oil lost ground sharply with weaker crude , but also suffered from some pricing pressure . High sulphur cracked fuel lost about $ 3 to $ 109-111 fob Med with several cargoes threatening to overhang the market . The chance of material heading north , talked earlier this week , may be in jeopardy now since American fuel oil is expected to head transatlantic following outages at two coking units in the U.S . Up to 165,000 tonnes of fuel will have to find a new home and with the arbitrage from the U.S. to Europe open Rotterdam is a prime candidate . Low sulphur prices were lower with cif Med pegged in the mid to low $ 140s . Gasoline prices fell after striking Elf refinery workers voted to go back to work , traders said . But an open arbitrage to the U.S. and tight Italian supplies after Elf scooped up Med material over the last week , continued to underpin prices into next week .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Elf\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [33, 36]}, \"target_uri\": \"http://dbpedia.org/resource/Elf_Aquitaine\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"LONDON\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [51, 57]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Elf\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [140, 143]}, \"target_uri\": \"http://dbpedia.org/resource/Elf_Aquitaine\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Genoa\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [392, 397]}, \"target_uri\": \"\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Syria\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [542, 547]}, \"target_uri\": \"http://dbpedia.org/resource/Syria\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Lebanon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [552, 559]}, \"target_uri\": \"http://dbpedia.org/resource/Lebanon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"France\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [596, 602]}, \"target_uri\": \"http://dbpedia.org/resource/France\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Spain\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [607, 612]}, \"target_uri\": \"http://dbpedia.org/resource/Spain\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"India\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [679, 684]}, \"target_uri\": \"http://dbpedia.org/resource/India\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"American\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1062, 1070]}, \"target_uri\": \"http://dbpedia.org/resource/United_States\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"U.S\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1159, 1162]}, \"target_uri\": \"http://dbpedia.org/resource/United_States\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"U.S.\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1255, 1259]}, \"target_uri\": \"http://dbpedia.org/resource/United_States\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Europe\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1263, 1269]}, \"target_uri\": \"http://dbpedia.org/resource/Europe\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Rotterdam\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1275, 1284]}, \"target_uri\": \"http://dbpedia.org/resource/Rotterdam\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Elf\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1421, 1424]}, \"target_uri\": \"http://dbpedia.org/resource/Elf_Aquitaine\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"U.S.\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1513, 1517]}, \"target_uri\": \"http://dbpedia.org/resource/United_States\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Italian\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1528, 1535]}, \"target_uri\": \"http://dbpedia.org/resource/Italy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Elf\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1551, 1554]}, \"target_uri\": \"http://dbpedia.org/resource/Elf_Aquitaine\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"New meningitis scare hits Britain . LONDON 1996-12-06 A boy has died from meningitis and a girl from the same school has contracted the disease in the second such scare to hit Britain in as many weeks , health authorities said on Friday . The 16-year-old who attended Sale Grammar School in the northern England city of Manchester died less than a day after becoming ill . The 15-year-old girl is also suffering from the disease and hospital officials described her condition as serious . \\\" At the moment there is no evidence the two cases are linked . However , we are assuming they are as a precaution for the time being , \\\" a spokeswoman said . The more than 1,260 students at the school are being given antibiotics as a precaution . Wales grappled with its own cluster of meningitis cases on a university campus in Cardiff . At least two people have died and hundreds have been vaccinated in an effort to contain the virus . In Scotland , eight people have died and hundreds more are fighting a widespread food-poisoning outbreak . A health authority spokeswoman said 78 people suspected of having the disease , including 64 confirmed cases , were still being treated . Three were listed in poor condition . More than 290 people have reported symptoms in Lanarkshire county , the worst-hit area , since the outbreak first came to light after people ate tainted meat pies at a pensioners ' lunch .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Britain\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [26, 33]}, \"target_uri\": \"http://dbpedia.org/resource/United_Kingdom\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"LONDON\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [36, 42]}, \"target_uri\": \"http://dbpedia.org/resource/London\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Britain\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [176, 183]}, \"target_uri\": \"http://dbpedia.org/resource/United_Kingdom\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Sale Grammar School\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [268, 287]}, \"target_uri\": \"http://dbpedia.org/resource/Sale_Grammar_School\"}, {\"py/object\": \"data.entity.