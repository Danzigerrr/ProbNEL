2 66129502\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Italy\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 5]}, \"target_uri\": \"http://dbpedia.org/resource/Italy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"ROME\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [53, 57]}, \"target_uri\": \"http://dbpedia.org/resource/Rome\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Italian\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [73, 80]}, \"target_uri\": \"http://dbpedia.org/resource/Italy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Italy\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [151, 156]}, \"target_uri\": \"http://dbpedia.org/resource/Italy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Milan\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [335, 340]}, \"target_uri\": \"http://dbpedia.org/resource/Milan\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"EU , Poland agree on oil import tariffs . BRUSSELS 1996-12-06 The European Union and Poland have resolved disagreements over a new Polish oil import regime , the European Commission said on Friday . The EU had objected to increases in Polish tariffs on imports of gasoline and gasoil products introduced on January 1 , 1996 , saying they contravened levels envisaged in the so-called Europe Agreement between the EU and Poland . The increases were aimed at protecting the Polish market while helping to modernise the local oil industry . \\\" The EU and Poland have now reached a final settlement regarding issues related to the Polish import regime in the oils sector , \\\" the Commission said in a statement . Under the agreement , Poland will abolish all oil import tariffs by 2001 , remove all oil price controls and end quantitative restrictions on imports by January 1 , 1997 . The agreement includes the early privatisation and modernisation of Polish oil refineries , which will be obliged to offer equal treatment to all buyers . The EU and Poland will monitor the settlement at six-monthly meetings .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Poland\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [5, 11]}, \"target_uri\": \"http://dbpedia.org/resource/Poland\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"BRUSSELS\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [42, 50]}, \"target_uri\": \"http://dbpedia.org/resource/Brussels\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"European Union\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [66, 80]}, \"target_uri\": \"http://dbpedia.org/resource/European_Union\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Poland\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [85, 91]}, \"target_uri\": \"http://dbpedia.org/resource/Poland\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Polish\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [131, 137]}, \"target_uri\": \"http://dbpedia.org/resource/Poland\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"European Commission\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [162, 181]}, \"target_uri\": \"http://dbpedia.org/resource/European_Commission\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Polish\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [235, 241]}, \"target_uri\": \"http://dbpedia.org/resource/Poland\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Europe\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [384, 390]}, \"target_uri\": \"http://dbpedia.org/resource/Europe\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Poland\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [420, 426]}, \"target_uri\": \"http://dbpedia.org/resource/Poland\"}, {\"py/object\": \"data.entity.TestEnti