", \"position\": {\"py/tuple\": [327, 335]}, \"target_uri\": \"http://dbpedia.org/resource/Pamplona\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Herri Batasuna\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [367, 381]}, \"target_uri\": \"http://dbpedia.org/resource/Batasuna\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Basque\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [406, 412]}, \"target_uri\": \"http://dbpedia.org/resource/Basque_Country_(greater_region)\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"ETA\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [430, 433]}, \"target_uri\": \"http://dbpedia.org/resource/ETA_(separatist_group)\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Spain\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [624, 629]}, \"target_uri\": \"http://dbpedia.org/resource/Spain\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Mussolini 's granddaughter rejoins far-right party . ROME 1996-12-06 Alessandra Mussolini , the granddaughter of Italy 's Fascist dictator Benito Mussolini , said on Friday she had rejoined the far-right National Alliance ( AN ) party she quit over policy differences last month . \\\" I 've gone back , \\\" she told a radio show shortly after AN leader Gianfranco Fini , who was being interviewed on the programme , said the row had been resolved . \\\" He did n't want to lose me and I did n't want to lose him . \\\" Fini told state radio RAI he met Mussolini thanks to the good offices of Giuseppe Tatarella , AN 's leader in the Chamber of Deputies ( lower house ) , and had overcome their differences . Mussolini , 33 , resigned from the parliamentary party group for what she said were strictly political reasons . The fiery politician , who is also a niece of screen star Sophia Loren , had accused AN leaders of stifling internal party debate . Mussolini , who sits in the Chamber , told La Stampa newspaper last month after quitting AN 's parliamentary party that she was considering joining the neo-fascist Social Movement ( MS-Fiamma ) formed by some of the Duce 's World War Two followers .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Mussolini\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 9]}, \"target_uri\": \"http://dbpedia.org/resource/Benito_Mussolini\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"ROME\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [53, 57]}, \"target_uri\": \"http://dbpedia.org/resource/Rome\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Alessandra Mussolini\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [69, 89]}, \"target_uri\": \"http://dbpedia.org/resource/Alessandra_Mussolini\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Italy\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [113, 118]}, \"target_uri\": \"http://dbpedia.org/resource/Italy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Benito Mussolini\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [139, 155]}, \"target_uri\": \"http://dbpedia.org/resource/Benito_Mussolini\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"National Alliance\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [204, 221]}, \"target_uri\": \"http://dbpedia.org/resource/National_Alliance_(Italy)\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Gianfranco Fini\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [349, 364]}, \"target_uri\": \"http://dbpedia.org/resource/Gianfranco_Fini\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Fini\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [509, 513]}, \"target_uri\": \"http://dbpedia.org/resource/Gianfranco_Fini\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"RAI\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [531, 534]}, \"