y/tuple\": [22, 28]}, \"target_uri\": \"http://dbpedia.org/resource/Hainan\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"BEIJING\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [48, 55]}, \"target_uri\": \"http://dbpedia.org/resource/Beijing\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"China\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [67, 72]}, \"target_uri\": \"http://dbpedia.org/resource/China\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Hainan\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [150, 156]}, \"target_uri\": \"http://dbpedia.org/resource/Hainan\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Xinhua\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [201, 207]}, \"target_uri\": \"http://dbpedia.org/resource/Xinhua_News_Agency\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Xinhua\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [237, 243]}, \"target_uri\": \"http://dbpedia.org/resource/Xinhua_News_Agency\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Wenchang\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [277, 285]}, \"target_uri\": \"http://dbpedia.org/resource/Wenchang\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Wenchang\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [328, 336]}, \"target_uri\": \"http://dbpedia.org/resource/Wenchang\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Xinhua\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [481, 487]}, \"target_uri\": \"http://dbpedia.org/resource/Xinhua_News_Agency\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Government disperses protest with water cannons . RANGOON 1996-12-07 Burmese troops and riot police moved in to disperse a student street protest at a suburban road junction near the Ranyon ( Rangoon ) University early on Saturday , witnesses said . They said police and troops used water cannons from fire engines to subdue about 120 university students sitting in at the centre of the junction at about 3 a.m. before they moved in to round them up . The students , who had staged an 11-hour protest at the junction in northern Rangoon , were taken away in three vehicles . The witnesses said some of the students were hit with batons while they were herded onto the vehicles and it was believed they were taken to the Insein prison in suburban Rangoon . The protesting students , mostly from Rangoon University , were demanding the right to organise independent unions on campuses and the release of about 80 student leaders currently in jail . They were among 500 students who started demonstrating at the intersection on late Friday afternoon . The protest was the second major one in five days in the capital .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"RANGOON\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [50, 57]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Burmese\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [69, 76]}, \"target_uri\": \"http://dbpedia.org/resource/Myanmar\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Rangoon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [529, 536]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Insein\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [720, 726]}, \"target_uri\": \"http://dbpedia.org/resource/Insein_Township\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Rangoon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [746, 753]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Rangoon University\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [794, 812]}, \"target_uri\": \"http://dbpedia.org/resource/University_of_Yangon\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Burmese students march briefly out of campus . Vithoon Amorn RANGOON 1996-12-06 About 200 Burmese students marched briefly from troubled Yangon Institute of Technology in northern Rangoon on Friday towards the University of Yangon six km ( four miles ) away , and returned to their campus , witnesses said . Seven truckloads of armed riot police and three fire engines were on standby at one of the junctions near the institute . There were no clashes . \\\" They are now back in the YIT campus , \\\" an institute official who declined to be identified told Reuters by telephone . One of two roads leading to the University of Yangon from the institute had been closed by authorities . But about 300 university students were still gathered outside the gates of their campus , witnesses said . They were singing peacefully . On Monday and Tuesday , students from the institute and the university launched protests against what they said was unfair handling by police of a brawl between some of their colleagues and restaurant owners in October . On Tuesday and Wednesday , opposition leader Aung San Suu Kyi was restricted to her home by the military government to prevent her from being drawn into the protests . She was allowed to move freely on Thursday . The protest culminated at dawn on Tuesday with several hundred students being detained briefly by police in central Rangoon . The street protests were the biggest seen in the capital since the student-led pro-democracry demonstrations of September 1988 when the junta crushed the uprising . Thousands were killed or imprisoned . Earlier on Friday some of the students , who were held briefly by police during the protests earlier this week , said they were still dissatisfied with the military government . They told Reuters they were unhappy that the ruling State Law and Order Restoration Council ( SLORC ) had not heeded their calls for the right to organise independent unions on campus . \\\" We still want government answers to our demands . We want police punishment to be published in newspapers , \\\" one student said . But the students stressed their protests were non-political and they had no contact with Suu Kyi 's National League for Democracy ( NLD ) . Suu Kyi , a Nobel laureate and daughter of independence hero Aung San , and key NLD officials have also denied any link with the students . But they have said both parties had a \\\" moral link \\\" in that they were against police brutality and injustice . The students also demanded the government announce punishments meted out to policemen who they said had manhandled students involved in a brawl with some restaurant owners near the Yangon institute in October . The students appealed to the government not to close the institute because of their latest demonstration . The institute was shut for nearly two years after the 1988 uprising . On Friday , the road leading to Suu Kyi 's lakeside residence in central Rangoon remained closed by police .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Burmese\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [0, 7]}, \"target_uri\": \"http://dbpedia.org/resource/Myanmar\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"RANGOON\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [61, 68]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Burmese\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [90, 97]}, \"target_uri\": \"http://dbpedia.org/resource/Myanmar\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Yangon Institute of Technology\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [137, 167]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon_Technological_University\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Rangoon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [180, 187]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"University of Yangon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [210, 230]}, \"target_uri\": \"http://dbpedia.org/resource/University_of_Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Reuters\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [553, 560]}, \"target_uri\": \"http://dbpedia.org/resource/Reuters\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"University of Yangon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [608, 628]}, \"target_uri\": \"http://dbpedia.org/resource/University_of_Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Aung San Suu Kyi\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1085, 1101]}, \"target_uri\": \"http://dbpedia.org/resource/Aung_San_Suu_Kyi\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Rangoon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1369, 1376]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Reuters\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [1770, 1777]}, \"target_uri\": \"http://dbpedia.org/resource/Reuters\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Suu Kyi\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2166, 2173]}, \"target_uri\": \"http://dbpedia.org/resource/Aung_San_Suu_Kyi\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"National League for Democracy\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2177, 2206]}, \"target_uri\": \"http://dbpedia.org/resource/National_League_for_Democracy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"NLD\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2209, 2212]}, \"target_uri\": \"http://dbpedia.org/resource/National_League_for_Democracy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Suu Kyi\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2217, 2224]}, \"target_uri\": \"http://dbpedia.org/resource/Aung_San_Suu_Kyi\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Nobel\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2229, 2234]}, \"target_uri\": \"http://dbpedia.org/resource/Nobel_Peace_Prize\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Aung San\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2278, 2286]}, \"target_uri\": \"http://dbpedia.org/resource/Aung_San\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"NLD\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2297, 2300]}, \"target_uri\": \"http://dbpedia.org/resource/National_League_for_Democracy\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Yangon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2650, 2656]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Suu Kyi\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2889, 2896]}, \"target_uri\": \"http://dbpedia.org/resource/Aung_San_Suu_Kyi\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Rangoon\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [2930, 2937]}, \"target_uri\": \"http://dbpedia.org/resource/Yangon\"}]}, {\"py/object\": \"data.text.TestText\", \"text\": \"Union leaders outraged by WTO snub to ILO head . SINGAPORE 1996-12-06 International trade union leaders on Friday expressed outrage that the head of the International Labour Organisation ( ILO ) had been barred from speaking at next week 's WTO meeting in Singapore . Bill Jordan , general secretary of the International Confederation of Free Trade Unions ( ICFTU ) , told a news conference the withdrawal of a WTO invitation to ILO director general Michel Hansenne was \\\" outrageous behaviour on the part of an organisation that wants to command respect in the world \\\" . Jordan said a small group of developing nations that oppose linking trade talks and labour conditions had pressured World Trade Organisation ( WTO ) officials to prevent Hansenne from taking the platform to urge such links . \\\" It is to their shame that those who are responsible for encouraging this meeting responded ( to the pressure ) in silencing him , \\\" Jordan said after the opening of an ICFTU conference on international labour standards and trade . The three-day trade union conference in Singapore hopes to push labour issues onto the WTO agenda . Jordan said the WTO 's credibility was at stake over the issue of trade and labour . The ICFTU said it wanted the WTO conference beginning on Monday to outlaw forced and child labour , end discrimination in hiring , and guarantee the right to join a union . Bill Brett , chairman of the ILO Workers Group , told Reuters before the news conference he was \\\" not too surprised , but very disappointed \\\" that the speaking invitation had been withdrawn . \\\" Some governments are very determined to stop the issue ( of trade and labour rights ) being discussed , \\\" he said , adding that the Association of Southeast Asian Nations ( ASEAN ) seemed particularly hostile to the ILO agenda . ASEAN groups Brunei , Indonesia , Malaysia , the Philippines , Singapore , Thailand and Vietnam . The ILO wants a trade and labour rights \\\" social clause \\\" included in the final ministerial statement issued by WTO leaders at the end of the meeting , the organization 's first ministerial-level gathering . Speaking to ICFTU delegates , Richard Eglin , director of the WTO secretariat , said the WTO was capable of making a significant contribution to governmental efforts to solve social problems . But he said the WTO 's organisational structure made it difficult to impose on its members a social clause such as that called for by the ILO .\", \"entity_mentions\": [{\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"WTO\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [26, 29]}, \"target_uri\": \"http://dbpedia.org/resource/World_Trade_Organization\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"ILO\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [38, 41]}, \"target_uri\": \"http://dbpedia.org/resource/International_Labour_Organization\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"SINGAPORE\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [49, 58]}, \"target_uri\": \"http://dbpedia.org/resource/Singapore\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"International Labour Organisation\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [153, 186]}, \"target_uri\": \"http://dbpedia.org/resource/International_Labour_Organization\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"ILO\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [189, 192]}, \"target_uri\": \"http://dbpedia.org/resource/International_Labour_Organization\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"WTO\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [241, 244]}, \"target_uri\": \"http://dbpedia.org/resource/World_Trade_Organization\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Singapore\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [256, 265]}, \"target_uri\": \"http://dbpedia.org/resource/Singapore\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"Bill Jordan\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [268, 279]}, \"target_uri\": \"http://dbpedia.org/resource/Bill_Jordan,_Baron_Jordan\"}, {\"py/object\": \"data.entity.TestEntity\", \"surface_form\": \"International Confederation of Free Trade Unions\", \"ner_class\": \"\", \"position\": {\"py/tuple\": [307, 355]}, \"target_uri\": \"http://dbpedia.org/resource/Internat